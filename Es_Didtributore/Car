public class Car{
    private double resa;
    private double carburante;

    public Car(){
        this.resa = 0.0;
        this.carburante = 0.0;
    }

    public Car(double r, double c) {
        if (r > 0.0){
            this.resa = r;
        }
        else{
            this.resa = 0.0;
        }

        if (c >= 0.0){
            this.carburante = c;
        }
        else{
            this.carburante = 0.0;
        }

    }
    public double getResa(){
        return this.resa;
    }

    public void setResa(double r){
        if(r > 0.0){
            this.resa = r;
        }
        else{
            this.resa = 0.0;
        }
    }
    
    public double getGas(){
        return this.carburante;
    }
    public void setGas(double c){
        if (c >= 0.0){
            this.carburante = c;
        }
        else {
            this.carburante = 0.0;
        }
    }

    public void drive(double km){
        if(km > 0.0 && this.resa > 0.0){
            double consumo = km * this.resa;

            if(consumo <= this.carburante){
                this.carburante -= consumo;
            }
            else{
                this.carburante = 0.0;
            }
        }
    }
    
    public void addGas (double quantita){
        if(quantita > 0.0){
            this.carburante += quantita;
        }
    }

    public String toString(){
        return "resa: " + this.resa + "\n carburante: " + this.carburante;
    }

}